{
  "name": "sports-house-randomizer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx tests/e2e.ts",
    "test": "npm run build && npm run test:e2e",
    "format": "prettier --write app lib models tests"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14",
      "disablePostinstall": true
    }
  },
  "dependencies": {
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.5",
    "mongodb": "^7.0.0",
    "mongoose": "^8.5.1",
    "next": "^16.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.4.39",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.1",
    "typescript": "^5.5.3"
  }
